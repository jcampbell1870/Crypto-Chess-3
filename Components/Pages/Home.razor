@page "/"

<PageTitle>Crypto Chess</PageTitle>

<div class="hero-section">
    <div class="hero-content">
        <h1 class="display-4">♟️ Crypto Chess</h1>
        <p class="lead">Play chess in your browser and earn Arcade1870 (ARC) tokens just for playing!</p>

        <div class="feature-highlights">
            <div class="feature-card">
                <h3>⚡ Play &amp; Earn</h3>
                <p>Complete a game and earn ARC tokens directly to your connected wallet</p>
            </div>
            <div class="feature-card">
                <h3>♟️ Classic Chess</h3>
                <p>Full chess rules with two players sharing one device to play locally</p>
            </div>
            <div class="feature-card">
                <h3>🔐 Secure</h3>
                <p>Connect with MetaMask for a secure, decentralized gaming experience</p>
            </div>
        </div>

        <div class="cta-buttons">
            <a href="/game" class="btn btn-primary btn-lg">
                Start Playing Now
            </a>
            <a href="/leaderboard" class="btn btn-outline-primary btn-lg">
                View Leaderboard
            </a>
        </div>
    </div>
</div>

<div class="info-section">
    <h2>How It Works</h2>
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="step-card">
                <div class="step-number">1</div>
                <h4>Connect Wallet</h4>
                <p>Connect your MetaMask wallet to get started</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="step-card">
                <div class="step-number">2</div>
                <h4>Play Chess</h4>
                <p>Play a full game of chess with a friend on the same device</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="step-card">
                <div class="step-number">3</div>
                <h4>Claim Reward</h4>
                <p>Finish the game and claim your ARC reward tokens</p>
            </div>
        </div>
    </div>
</div>
