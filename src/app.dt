use ai::{choose_demo_reply, Difficulty};
use chess::{Board, Color, GameOutcome, Move};
use reward::{ClaimService, RewardClaim, RewardConfig, RewardError, WalletProfile};

pub enum GameMode {
  LocalTwoPlayer,
  VersusComputer(Difficulty, Color),
}

pub struct CryptoChessApp {
  board: Board,
  wallet: WalletProfile,
  rewards: ClaimService,
  mode: GameMode,
  reward_claimed: bool,
  turn_status: str,
  game_status: str,
  claim_status: str,
}

pub fn new_app(board: Board, wallet: WalletProfile, reward_config: RewardConfig) -> CryptoChessApp {
  return CryptoChessApp {
    board: board,
    wallet: wallet,
    rewards: ClaimService { config: reward_config },
    mode: GameMode::LocalTwoPlayer,
    reward_claimed: false,
    turn_status: "White to move",
    game_status: "",
    claim_status: "Connect your wallet to claim rewards",
  };
}

impl CryptoChessApp {
  fn is_human_turn(&self) -> bool {
    match self.mode {
      GameMode::LocalTwoPlayer => return true,
      GameMode::VersusComputer(_, human_color) => {
        match (self.board.turn, human_color) {
          (Color::White, Color::White) => return true,
          (Color::Black, Color::Black) => return true,
          _ => return false,
        }
      }
    }
  }

  fn is_computer_turn(&self) -> bool {
    match self.mode {
      GameMode::LocalTwoPlayer => return false,
      GameMode::VersusComputer(_, human_color) => {
        match (self.board.turn, human_color) {
          (Color::White, Color::White) => return false,
          (Color::Black, Color::Black) => return false,
          _ => return true,
        }
      }
    }
  }

  pub fn connect_wallet(&mut self, address: str) {
    self.wallet.address = address;
    self.wallet.connected = true;
    self.claim_status = "Wallet connected";
  }

  pub fn enable_computer(&mut self, level: Difficulty, human_color: Color) {
    self.mode = GameMode::VersusComputer(level, human_color);
  }

  pub fn apply_human_move(&mut self, mv: Move, outcome: Option<GameOutcome>) {
    if self.board.is_complete() || !self.is_human_turn() {
      return;
    }
    self.board.apply_move(mv);
    self.reward_claimed = false;
    match outcome {
      Some(result) => {
        self.board.finish(result);
        self.game_status = self.board.winner_text();
        self.turn_status = "Game over";
        return;
      }
      None => {}
    }
    self.turn_status = match self.board.turn {
      Color::White => "White to move",
      Color::Black => "Black to move",
    };
  }

  pub fn maybe_play_ai_turn(&mut self) {
    match self.mode {
      GameMode::VersusComputer(level, _) => {
        if self.board.is_complete() || !self.is_computer_turn() {
          return;
        }
        let maybe_reply = choose_demo_reply(&self.board, level);
        match maybe_reply {
          Some(reply) => {
            self.board.apply_move(reply.mv);
            self.reward_claimed = false;
            match reply.outcome {
              Some(outcome) => {
                self.board.finish(outcome);
                self.turn_status = "Game over";
                self.game_status = self.board.winner_text();
              }
              None => {
                self.turn_status = match self.board.turn {
                  Color::White => "White to move",
                  Color::Black => "Black to move",
                };
                self.game_status = "Computer played a demo response";
              }
            }
          }
          None => {
            self.game_status = "No demo AI response is available for this position";
          }
        }
      }
      GameMode::LocalTwoPlayer => {}
    }
  }

  pub fn finalize_reward(&mut self) -> Result<RewardClaim, RewardError> {
    if self.reward_claimed {
      return Err(RewardError::RewardAlreadyClaimed);
    }
    let claim = self.rewards.issue_claim(&self.wallet, &self.board)?;
    self.reward_claimed = true;
    self.claim_status = "Reward ready to claim";
    return Ok(claim);
  }
}
