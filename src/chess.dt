pub enum Color {
  White,
  Black,
}

pub enum PieceKind {
  Pawn,
  Knight,
  Bishop,
  Rook,
  Queen,
  King,
}

pub enum GameOutcome {
  InProgress,
  Checkmate(Color),
  Stalemate,
  Draw,
  Aborted,
}

pub struct Square {
  file: u8,
  rank: u8,
}

pub struct Move {
  from: Square,
  to: Square,
  san: str,
  promotion: Option<PieceKind>,
  resulting_fen: str,
}

pub struct Board {
  game_id: u64,
  fen: str,
  pgn: str,
  turn: Color,
  plies: u32,
  outcome: GameOutcome,
}

pub fn opposite(color: Color) -> Color {
  match color {
    Color::White => return Color::Black,
    Color::Black => return Color::White,
  }
}

pub fn starting_board() -> Board {
  return Board {
    game_id: 1,
    fen: "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
    pgn: "",
    turn: Color::White,
    plies: 0,
    outcome: GameOutcome::InProgress,
  };
}

