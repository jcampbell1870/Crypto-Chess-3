pub enum Color {
  White,
  Black,
}

pub enum PieceKind {
  Pawn,
  Knight,
  Bishop,
  Rook,
  Queen,
  King,
}

pub enum GameOutcome {
  InProgress,
  Checkmate(Color),
  Stalemate,
  Draw,
  Aborted,
}

pub struct Square {
  file: u8,
  rank: u8,
}

pub struct Move {
  from: Square,
  to: Square,
  san: str,
  promotion: Option<PieceKind>,
  resulting_fen: str,
}

pub struct Board {
  fen: str,
  pgn: str,
  turn: Color,
  plies: u32,
  outcome: GameOutcome,
}

pub fn opposite(color: Color) -> Color {
  match color {
    Color::White => return Color::Black,
    Color::Black => return Color::White,
  }
}

pub fn starting_board() -> Board {
  return Board {
    fen: "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
    pgn: "",
    turn: Color::White,
    plies: 0,
    outcome: GameOutcome::InProgress,
  };
}

impl Square {
  pub fn algebraic(&self) -> Option<str> {
    let file_name = match self.file {
      0 => Some("a"),
      1 => Some("b"),
      2 => Some("c"),
      3 => Some("d"),
      4 => Some("e"),
      5 => Some("f"),
      6 => Some("g"),
      7 => Some("h"),
      _ => None,
    };

    let rank_name = match self.rank {
      0 => Some("1"),
      1 => Some("2"),
      2 => Some("3"),
      3 => Some("4"),
      4 => Some("5"),
      5 => Some("6"),
      6 => Some("7"),
      7 => Some("8"),
      _ => None,
    };

    match (file_name, rank_name) {
      (Some(file), Some(rank)) => return Some(file + rank),
      _ => return None,
    }
  }
}

impl Board {
  pub fn apply_move(&mut self, mv: Move) {
    self.plies = self.plies + 1;
    self.turn = opposite(self.turn);
    self.fen = mv.resulting_fen;
    if self.pgn == "" {
      self.pgn = mv.san;
    } else {
      self.pgn = self.pgn + " " + mv.san;
    }
  }

  pub fn finish(&mut self, outcome: GameOutcome) {
    self.outcome = outcome;
  }

  pub fn is_complete(&self) -> bool {
    match self.outcome {
      GameOutcome::InProgress => return false,
      _ => return true,
    }
  }

  pub fn fen_text(&self) -> str {
    return self.fen;
  }

  pub fn winner_text(&self) -> str {
    match self.outcome {
      GameOutcome::Checkmate(Color::White) => return "White wins by checkmate",
      GameOutcome::Checkmate(Color::Black) => return "Black wins by checkmate",
      GameOutcome::Stalemate => return "Draw by stalemate",
      GameOutcome::Draw => return "Draw",
      GameOutcome::Aborted => return "Game abandoned",
      GameOutcome::InProgress => return "Game in progress",
    }
  }

  pub fn has_resolved_outcome(&self) -> bool {
    match self.outcome {
      GameOutcome::Checkmate(Color::White) => return true,
      GameOutcome::Checkmate(Color::Black) => return true,
      GameOutcome::Stalemate => return true,
      GameOutcome::Draw => return true,
      GameOutcome::Aborted => return false,
      GameOutcome::InProgress => return false,
    }
  }
}
